      "source": [
        "# Feed Forward Neural Network\n",
        "\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "\n",
        "# Training data\n",
        "X = [\n",
        "    [0, 0],\n",
        "    [0, 1],\n",
        "    [1, 0],\n",
        "    [1, 1]\n",
        "]\n",
        "\n",
        "# Target output (AND gate)\n",
        "y = [0, 0, 0, 1]\n",
        "\n",
        "# Create Feed Forward Neural Network\n",
        "model = MLPClassifier(\n",
        "    hidden_layer_sizes=(4,),\n",
        "    activation='relu',\n",
        "    solver='lbfgs',\n",
        "    max_iter=1000,\n",
        "    random_state=1\n",
        ")\n",
        "\n",
        "# Train the network\n",
        "model.fit(X, y)\n",
        "\n",
        "# Test the network\n",
        "predictions = model.predict(X)\n",
        "\n",
        "print(\"Input\\tOutput\")\n",
        "\n",
        "for i in range(len(X)):\n",
        "    print(X[i], \"\\t\", predictions[i])\n",
        "\n",
        "# Test a new input\n",
        "new_input = [[1, 1]]\n",
        "result = model.predict(new_input)\n",
        "\n",
        "print(\"\\nInput:\", new_input)\n",
        "print(\"Predicted Output:\", result[0])"
      ]
    }
