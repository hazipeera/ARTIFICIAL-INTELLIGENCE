        "import string\n",
        "\n",
        "# Get string from the user\n",
        "text = input(\"Enter a string: \")\n",
        "\n",
        "# Remove punctuation\n",
        "result = \"\"\n",
        "\n",
        "for char in text:\n",
        "    if char not in string.punctuation:\n",
        "        result += char\n",
        "\n",
        "print(\"String after removing punctuations:\", result)"
