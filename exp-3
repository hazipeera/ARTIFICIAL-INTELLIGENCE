        "# Transpose of a Matrix\n",
        "\n",
        "r = int(input(\"Enter number of rows: \"))\n",
        "c = int(input(\"Enter number of columns: \"))\n",
        "\n",
        "A = []\n",
        "\n",
        "print(\"Enter matrix elements:\")\n",
        "for i in range(r):\n",
        "    A.append(list(map(int, input().split())))\n",
        "\n",
        "print(\"Transpose of the matrix:\")\n",
        "for j in range(c):\n",
        "    for i in range(r):\n",
        "        print(A[i][j], end=\" \")\n",
        "    print()"
