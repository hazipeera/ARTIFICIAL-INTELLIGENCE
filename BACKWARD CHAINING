        "# -------------------------------\n",
        "# Backward Chaining Example\n",
        "# -------------------------------\n",
        "\n",
        "# Facts stored in knowledge base\n",
        "facts = {\n",
        "    \"Human(Socrates)\"\n",
        "}\n",
        "\n",
        "# Rules stored as:\n",
        "# conclusion : premise\n",
        "rules = {\n",
        "    \"Mortal(Socrates)\": \"Human(Socrates)\"\n",
        "}\n",
        "\n",
        "# Recursive backward chaining function\n",
        "def backward_chain(goal):\n",
        "\n",
        "    print(f\"\\nTrying to prove: {goal}\")\n",
        "\n",
        "    # Step 1: Check whether goal is already a fact\n",
        "    if goal in facts:\n",
        "        print(f\"{goal} is a FACT.\")\n",
        "        return True\n",
        "\n",
        "    # Step 2: Check if any rule can prove it\n",
        "    if goal in rules:\n",
        "\n",
        "        premise = rules[goal]\n",
        "\n",
        "        print(f\"Need to prove: {premise}\")\n",
        "\n",
        "        if backward_chain(premise):\n",
        "            print(f\"Rule applied:\")\n",
        "            print(f\"{premise} --> {goal}\")\n",
        "            return True\n",
        "\n",
        "    print(f\"Cannot prove {goal}\")\n",
        "    return False\n",
        "\n",
        "\n",
        "# Goal\n",
        "goal = \"Mortal(Socrates)\"\n",
        "\n",
        "print(\"Backward Chaining\")\n",
        "\n",
        "if backward_chain(goal):\n",
        "    print(\"\\nGoal PROVED\")\n",
        "else:\n",
        "    print(\"\\nGoal NOT PROVED\")"
      ]
    },
