        "# Forward Chaining Example\n",
        "\n",
        "# Initial fact\n",
        "facts = {\"Study\"}\n",
        "\n",
        "# Rule: If Study then Pass\n",
        "if \"Study\" in facts:\n",
        "    facts.add(\"Pass\")\n",
        "\n",
        "# Print inferred facts\n",
        "print(\"Knowledge Base:\")\n",
        "for fact in facts:\n",
        "    print(fact)"
