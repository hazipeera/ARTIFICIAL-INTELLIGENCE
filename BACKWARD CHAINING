        "# Knowledge Representation using Python\n",
        "\n",
        "# --------------------------\n",
        "# Facts\n",
        "# --------------------------\n",
        "facts = {\"Cat(Tom)\"}\n",
        "\n",
        "# --------------------------\n",
        "# Rules\n",
        "# Key = Conclusion\n",
        "# Value = Required Fact\n",
        "# --------------------------\n",
        "rules = {\n",
        "    \"Mammal(Tom)\": \"Cat(Tom)\",\n",
        "    \"Animal(Tom)\": \"Mammal(Tom)\"\n",
        "}\n",
        "\n",
        "print(\"Initial Facts:\")\n",
        "for fact in facts:\n",
        "    print(fact)\n",
        "\n",
        "print(\"\\nApplying Rules...\")\n",
        "\n",
        "# Keep applying rules until no new facts are added\n",
        "changed = True\n",
        "\n",
        "while changed:\n",
        "    changed = False\n",
        "\n",
        "    for conclusion, premise in rules.items():\n",
        "\n",
        "        if premise in facts and conclusion not in facts:\n",
        "            facts.add(conclusion)\n",
        "            print(f\"Derived: {conclusion}\")\n",
        "            changed = True\n",
        "\n",
        "print(\"\\nFinal Knowledge Base:\")\n",
        "for fact in facts:\n",
        "    print(fact)"
      ],
