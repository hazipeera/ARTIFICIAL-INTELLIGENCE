        "# List Methods: Add, Append, Extend and Delete\n",
        "\n",
        "L = [10, 20, 30]\n",
        "\n",
        "# Add\n",
        "L.insert(1, 15)\n",
        "print(\"After Add:\", L)\n",
        "\n",
        "# Append\n",
        "L.append(40)\n",
        "print(\"After Append:\", L)\n",
        "\n",
        "# Extend\n",
        "L.extend([50, 60])\n",
        "print(\"After Extend:\", L)\n",
        "\n",
        "# Delete\n",
        "L.remove(20)\n",
        "print(\"After Delete:\", L)"
