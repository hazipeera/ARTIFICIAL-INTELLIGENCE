      "source": [
        "# Vacuum Cleaner Problem\n",
        "\n",
        "def vacuum_cleaner():\n",
        "    room = {\n",
        "        \"A\": input(\"Enter status of Room A (Clean/Dirty): \").lower(),\n",
        "        \"B\": input(\"Enter status of Room B (Clean/Dirty): \").lower()\n",
        "    }\n",
        "\n",
        "    current = input(\"Enter starting room (A/B): \").upper()\n",
        "\n",
        "    print(\"\\nInitial State:\", room)\n",
        "\n",
        "    while room[\"A\"] == \"dirty\" or room[\"B\"] == \"dirty\":\n",
        "\n",
        "        print(\"\\nVacuum is in Room\", current)\n",
        "\n",
        "        if room[current] == \"dirty\":\n",
        "            print(\"Action: Suck\")\n",
        "            room[current] = \"clean\"\n",
        "        else:\n",
        "            print(\"Action: Move\")\n",
        "\n",
        "            if current == \"A\":\n",
        "                current = \"B\"\n",
        "            else:\n",
        "                current = \"A\"\n",
        "\n",
        "    print(\"\\nAll rooms are clean!\")\n",
        "    print(\"Final State:\", room)\n",
        "\n",
        "\n",
        "vacuum_cleaner()\n"
      ]
