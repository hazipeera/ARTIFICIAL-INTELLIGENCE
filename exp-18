      "source": [
        "from itertools import permutations\n",
        "\n",
        "# Distance matrix\n",
        "graph = [\n",
        "    [0, 10, 15, 20],\n",
        "    [10, 0, 35, 25],\n",
        "    [15, 35, 0, 30],\n",
        "    [20, 25, 30, 0]\n",
        "]\n",
        "\n",
        "n = len(graph)\n",
        "\n",
        "# Starting city\n",
        "start = 0\n",
        "\n",
        "# Generate all possible routes\n",
        "cities = list(range(1, n))\n",
        "\n",
        "min_cost = float('inf')\n",
        "best_route = None\n",
        "\n",
        "for route in permutations(cities):\n",
        "    current = start\n",
        "    cost = 0\n",
        "\n",
        "    for city in route:\n",
        "        cost += graph[current][city]\n",
        "        current = city\n",
        "\n",
        "    # Return to starting city\n",
        "    cost += graph[current][start]\n",
        "\n",
        "    if cost < min_cost:\n",
        "        min_cost = cost\n",
        "        best_route = (start,) + route + (start,)\n",
        "\n",
        "# Display result\n",
        "print(\"Best Route:\", end=\" \")\n",
        "\n",
        "for city in best_route:\n",
        "    print(city + 1, end=\" \")\n",
        "\n",
        "print(\"\\nMinimum Cost:\", min_cost)"
      ]
    }
