        "from itertools import permutations\n",
        "\n",
        "# Crypt-Arithmetic: SEND + MORE = MONEY\n",
        "\n",
        "letters = \"SENDMORY\"\n",
        "\n",
        "for p in permutations(range(10), len(letters)):\n",
        "    S, E, N, D, M, O, R, Y = p\n",
        "\n",
        "    # S and M cannot be zero\n",
        "    if S == 0 or M == 0:\n",
        "        continue\n",
        "\n",
        "    SEND = 1000*S + 100*E + 10*N + D\n",
        "    MORE = 1000*M + 100*O + 10*R + E\n",
        "    MONEY = 10000*M + 1000*O + 100*N + 10*E + Y\n",
        "\n",
        "    if SEND + MORE == MONEY:\n",
        "        print(\"Solution found:\")\n",
        "        print(\"S =\", S)\n",
        "        print(\"E =\", E)\n",
        "        print(\"N =\", N)\n",
        "        print(\"D =\", D)\n",
        "        print(\"M =\", M)\n",
        "        print(\"O =\", O)\n",
        "        print(\"R =\", R)\n",
        "        print(\"Y =\", Y)\n",
        "\n",
        "        print(\"\\n\", SEND)\n",
        "        print(\"+\", MORE)\n",
        "        print(\"------\")\n",
        "        print(MONEY)\n",
        "        break"
      ]
