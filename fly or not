        "family = {\n",
        "    \"arun\": {\"gender\": \"male\", \"parent\": [\"ravi\", \"meena\"]},\n",
        "    \"kiran\": {\"gender\": \"female\", \"parent\": [\"ravi\", \"meena\"]},\n",
        "    \"ajay\": {\"gender\": \"male\", \"parent\": [\"arun\", \"sita\"]},\n",
        "    \"rahul\": {\"gender\": \"male\", \"parent\": [\"arun\", \"sita\"]},\n",
        "    \"sita\": {\"gender\": \"female\", \"parent\": [\"kumar\", \"lakshmi\"]},\n",
        "    \"ravi\": {\"gender\": \"male\", \"parent\": [\"kumar\", \"lakshmi\"]},\n",
        "    \"meena\": {\"gender\": \"female\", \"parent\": [\"ram\", \"geetha\"]}\n",
        "}\n",
        "\n",
        "\n",
        "def relation(a, b):\n",
        "\n",
        "    # Parent\n",
        "    if a in family and b in family[a][\"parent\"]:\n",
        "        if family[a][\"gender\"] == \"male\":\n",
        "            return \"father\"\n",
        "        return \"mother\"\n",
        "\n",
        "    # Child\n",
        "    if b in family and a in family[b][\"parent\"]:\n",
        "        if family[a][\"gender\"] == \"male\":\n",
        "            return \"son\"\n",
        "        return \"daughter\"\n",
        "\n",
        "    # Sibling\n",
        "    if a in family and b in family:\n",
        "        parents_a = set(family[a][\"parent\"])\n",
        "        parents_b = set(family[b][\"parent\"])\n",
        "\n",
        "        if parents_a & parents_b:\n",
        "            if family[a][\"gender\"] == \"male\":\n",
        "                return \"brother\"\n",
        "            return \"sister\"\n",
        "\n",
        "    # Grandparent\n",
        "    if a in family and b in family:\n",
        "        for parent in family[b][\"parent\"]:\n",
        "            if parent in family and a in family[parent][\"parent\"]:\n",
        "                if family[a][\"gender\"] == \"male\":\n",
        "                    return \"grandfather\"\n",
        "                return \"grandmother\"\n",
        "\n",
        "    # Grandchild\n",
        "    if a in family and b in family:\n",
        "        for parent in family[a][\"parent\"]:\n",
        "            if parent in family and b in family[parent][\"parent\"]:\n",
        "                if family[a][\"gender\"] == \"male\":\n",
        "                    return \"grandson\"\n",
        "                return \"granddaughter\"\n",
        "\n",
        "    return \"Relationship not found\"\n",
        "\n",
        "\n",
        "person1 = input(\"Enter first person: \").lower()\n",
        "person2 = input(\"Enter second person: \").lower()\n",
        "\n",
        "print(person1, \"is the\", relation(person1, person2), \"of\", person2)"
