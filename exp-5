      "source": [
        "# List Operations\n",
        "\n",
        "L = [10, 20, 30, 40, 50]\n",
        "\n",
        "# Nested List\n",
        "nested = [1, 2, [3, 4], 5]\n",
        "print(\"Nested List:\", nested)\n",
        "\n",
        "# Length\n",
        "print(\"Length:\", len(L))\n",
        "\n",
        "# Concatenation\n",
        "L2 = [60, 70]\n",
        "print(\"Concatenation:\", L + L2)\n",
        "\n",
        "# Membership\n",
        "print(\"30 in List:\", 30 in L)\n",
        "\n",
        "# Iteration\n",
        "print(\"Iteration:\")\n",
        "for x in L:\n",
        "    print(x)\n",
        "\n",
        "# Indexing\n",
        "print(\"Element at index 2:\", L[2])\n",
        "\n",
        "# Slicing\n",
        "print(\"Slicing:\", L[1:4])"
      ]
